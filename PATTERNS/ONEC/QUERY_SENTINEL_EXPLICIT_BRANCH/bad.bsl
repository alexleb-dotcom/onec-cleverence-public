// ILLUSTRATIVE_PATTERN: NOT EVIDENCE. Empty-reference semantics are placeholders.
Функция ПолучитьДанные(СсылкаИлиПусто)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Данные.Ссылка
    |ИЗ
    |    Справочник.Пример КАК Данные
    |ГДЕ
    |    &СсылкаИлиПусто = ЗНАЧЕНИЕ(Справочник.Пример.ПустаяСсылка)
    |    ИЛИ Данные.Ссылка = &СсылкаИлиПусто";

    // BAD: an empty value silently changes point lookup into broad selection.
    Запрос.УстановитьПараметр("СсылкаИлиПусто", СсылкаИлиПусто);
    Возврат Запрос.Выполнить();

КонецФункции
