// ILLUSTRATIVE_PATTERN: NOT EVIDENCE. Bulk authorization is project-specific.
Функция ПолучитьДанные(Ссылка, МассовыйРежим)

    Запрос = Новый Запрос;

    Если МассовыйРежим Тогда
        // GOOD SHAPE: bulk behavior is explicit and must be authorized by the caller contract.
        Запрос.Текст =
        "ВЫБРАТЬ
        |    Данные.Ссылка
        |ИЗ
        |    Справочник.Пример КАК Данные";
    Иначе
        Запрос.Текст =
        "ВЫБРАТЬ
        |    Данные.Ссылка
        |ИЗ
        |    Справочник.Пример КАК Данные
        |ГДЕ
        |    Данные.Ссылка = &Ссылка";
        Запрос.УстановитьПараметр("Ссылка", Ссылка);
    КонецЕсли;

    Возврат Запрос.Выполнить();

КонецФункции
