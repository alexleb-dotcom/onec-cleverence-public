// ILLUSTRATIVE_PATTERN: NOT EVIDENCE. Query schema is neutral.
Функция ПолучитьТекстЗапроса(ДобавлятьФильтр)

    Текст =
    "ВЫБРАТЬ
    |    Данные.Ссылка
    |ИЗ
    |    Справочник.Пример КАК Данные
    |ГДЕ
    |    Данные.ПометкаУдаления = ЛОЖЬ
    |/*ДОПОЛНИТЕЛЬНЫЙ_ФИЛЬТР*/";

    // BAD: surgery on query text creates a second parser/position contract.
    Если ДобавлятьФильтр Тогда
        Текст = СтрЗаменить(Текст, "/*ДОПОЛНИТЕЛЬНЫЙ_ФИЛЬТР*/", "И Данные.Код = &Код");
    Иначе
        Текст = СтрЗаменить(Текст, "/*ДОПОЛНИТЕЛЬНЫЙ_ФИЛЬТР*/", "");
    КонецЕсли;

    Возврат Текст;

КонецФункции
