// ILLUSTRATIVE_PATTERN: NOT EVIDENCE. Query schema is neutral.
Функция ПолучитьТекстЗапроса(ДобавлятьФильтр)

    Если ДобавлятьФильтр Тогда
        Возврат
        "ВЫБРАТЬ
        |    Данные.Ссылка
        |ИЗ
        |    Справочник.Пример КАК Данные
        |ГДЕ
        |    Данные.ПометкаУдаления = ЛОЖЬ
        |    И Данные.Код = &Код";
    КонецЕсли;

    // GOOD SHAPE: each stored variant is complete query language.
    Возврат
    "ВЫБРАТЬ
    |    Данные.Ссылка
    |ИЗ
    |    Справочник.Пример КАК Данные
    |ГДЕ
    |    Данные.ПометкаУдаления = ЛОЖЬ";

КонецФункции
