<Window x:Class="OneCArchitecture.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Style="{StaticResource {x:Type Window}}" Icon="pack://application:,,,/OneCArchitecture.ControlCenter;component/Assets/OneCOrbit.BrandMark.256.png" Title="OneC Orbit" Width="1180" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle" Closing="Window_Closing">
  <Grid Background="{DynamicResource WindowBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,16,8,8" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/OneCArchitecture.ControlCenter;component/Assets/OneCOrbit.BrandMark.256.png" Width="28" Height="28" Stretch="Uniform"
                   SnapsToDevicePixels="True" UseLayoutRounding="True" Margin="0,0,10,0"
                   AutomationProperties.Name="OneC Orbit" IsHitTestVisible="False"/>
            <TextBlock Text="OneC Orbit" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="ProductVersionText" Text="Control Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="8,0,8,24"/>
          <Button x:Name="NavHomeButton" Style="{StaticResource NavButton}" Content="Home" Tag="Home" Click="Nav_Click" AutomationProperties.Name="Home"/>
          <Button x:Name="NavProjectsButton" Style="{StaticResource NavButton}" Content="Projects" Tag="Projects" Click="Nav_Click" AutomationProperties.Name="Projects"/>
          <Button x:Name="NavWorkButton" Style="{StaticResource NavButton}" Content="Work" Tag="Work" Click="Nav_Click" AutomationProperties.Name="Work"/>
          <Button x:Name="NavActivityButton" Style="{StaticResource NavButton}" Content="MCP Activity" Tag="Activity" Click="Nav_Click" AutomationProperties.Name="MCP Activity"/>
          <Button x:Name="NavMaintenanceButton" Style="{StaticResource NavButton}" Content="Maintenance" Tag="Maintenance" Click="Nav_Click" AutomationProperties.Name="Maintenance"/>
          <Button x:Name="NavSettingsButton" Style="{StaticResource NavButton}" Content="Settings" Tag="Settings" Click="Nav_Click" AutomationProperties.Name="Settings"/>
          <Button x:Name="NavAdvancedButton" Style="{StaticResource NavButton}" Content="Advanced" Tag="Advanced" Click="Nav_Click" AutomationProperties.Name="Advanced"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <TextBlock x:Name="CloseHintText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Margin="8,16"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Home" Style="{StaticResource SectionText}"/>
          <TextBlock x:Name="SelectedProjectText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock x:Name="LastUpdatedText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,7" Margin="0,0,10,0">
          <TextBlock x:Name="HelperBadge" Text="Helper —" FontWeight="SemiBold"/>
        </Border>
        <Button Grid.Column="2" VerticalAlignment="Center" x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" AutomationProperties.Name="Refresh current state"/>
      </Grid>

      <Grid Grid.Row="1">
        <!-- HOME: selected project, owner recommendation, safe navigation. -->
        <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
          <StackPanel Margin="0,0,8,0">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel>
                <TextBlock x:Name="CurrentWorkLabel" Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="HomeProjectText" Style="{StaticResource TitleText}" Margin="0,8,0,8"/>
                <TextBlock x:Name="HomeTaskText" TextWrapping="Wrap"/>
                <TextBlock x:Name="HomeHelperText" Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,24,0,24"/>
                <TextBlock x:Name="RecommendedLabel" Style="{StaticResource CaptionText}"/>
                <TextBlock x:Name="RecommendationText" Style="{StaticResource SectionText}" Margin="0,8,0,8"/>
                <TextBlock x:Name="RecommendationReasonText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                <Button x:Name="HomePrimaryButton" Style="{StaticResource PrimaryButton}" Content="Projects" Tag="Projects" Click="Nav_Click" HorizontalAlignment="Left" MinWidth="144" MinHeight="40" Margin="0,24,0,0"/>
              </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,16" Margin="0,8,0,0">
              <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="HomeDetailsButton" Content="Advanced" Tag="Advanced" Click="Nav_Click" Margin="16,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="SourceTitleLabel" Style="{StaticResource CaptionText}"/>
                  <TextBlock x:Name="SourceStateText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- PROJECTS -->
        <Grid x:Name="ProjectsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" VerticalAlignment="Top"><TextBlock x:Name="ProjectsHintText" TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel>
          <ListView Margin="0,68,0,0" SelectionMode="Single" SelectionChanged="ProjectsList_SelectionChanged" x:Name="ProjectsList" AutomationProperties.Name="Projects list">
            <ListView.View><GridView>
              <GridViewColumn Header="Project" DisplayMemberBinding="{Binding DisplayName}" Width="250"/>
              <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="260"/>
              <GridViewColumn Header="Participants" DisplayMemberBinding="{Binding Participants}" Width="110"/>
            </GridView></ListView.View>
          </ListView>
          <WrapPanel Grid.Row="1" Margin="0,14,0,0">
            <Button x:Name="AddProjectButton" Content="Add project" Click="AddProject_Click" IsEnabled="False"/>
            <Button x:Name="OpenSourceButton" Content="Open Source folder" Click="OpenSource_Click" IsEnabled="False" Margin="8,4,0,4"/>
            <Button x:Name="ApplyButton" Content="Refresh managed Source" Click="Apply_Click" IsEnabled="False" Margin="8,4,0,4"/>
          </WrapPanel>
        </Grid>

        <!-- WORK -->
        <ScrollViewer x:Name="WorkPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
              <StackPanel>
                <TextBlock x:Name="WorkStatusText" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="WorkDetailText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,18"/>
                <TextBlock x:Name="SessionHelpText" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <TextBlock x:Name="WorkPromptLabel" Text="What needs to be done?" FontWeight="SemiBold"/>
                <TextBox x:Name="TaskGoalTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Margin="0,7,0,10" AutomationProperties.Name="Task description"/>
                <WrapPanel>
                  <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="Start work" Click="Start_Click" IsEnabled="False"/>
                  <Button x:Name="ContinueButton" Content="Continue previous task" Click="Continue_Click" IsEnabled="False" Margin="8,4,0,4"/>
                  <Button x:Name="StopButton" Content="Stop work" Click="Stop_Click" IsEnabled="False" Margin="8,4,0,4"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,14,0,0">
              <StackPanel><TextBlock x:Name="ActionAvailabilityText" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock x:Name="WorkRecoveryLabel" Text="Recovery / checkpoint" FontWeight="SemiBold"/><TextBlock x:Name="WorkCheckpointText" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Expander x:Name="HomeWorkDetails" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0">
              <Expander.Header><TextBlock x:Name="WorkDetailsLabel" Text="Task details"/></Expander.Header>
              <StackPanel Margin="8,16,8,8">
                <TextBlock x:Name="CheckpointTitleLabel" Style="{StaticResource SectionText}"/>
                <TextBlock x:Name="CheckpointStateText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="CheckpointSummaryText" Style="{StaticResource CaptionText}" Margin="0,8,0,16"/>
                <TextBlock x:Name="OutputTitleLabel" Style="{StaticResource SectionText}"/>
                <TextBlock x:Name="OutputStateText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="OutputSummaryText" Style="{StaticResource CaptionText}" Margin="0,8,0,8"/>
                <WrapPanel>
                  <Button x:Name="HomeOpenOutputButton" Content="Open Output" Click="OpenOutput_Click" IsEnabled="False"/>
                  <Button x:Name="HomeStopButton" Content="Stop work" Click="Stop_Click" IsEnabled="False" Margin="8,4,0,4"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <!-- ACTIVITY -->
        <Grid x:Name="ActivityPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <WrapPanel Margin="0,0,0,8">
              <TextBlock x:Name="McpTitleLabel" FontWeight="SemiBold" Margin="0,0,16,0"/>
              <TextBlock x:Name="McpStateText" Margin="0,0,16,0"/>
              <TextBlock x:Name="McpUsageText" Margin="0,0,16,0"/>
              <TextBlock x:Name="McpEpochText"/>
            </WrapPanel>
            <TextBlock x:Name="McpPolicyText" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
          <TextBlock x:Name="ActivitySummaryText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>
          </StackPanel>
          <DataGrid Grid.Row="1" x:Name="ActivityList" AutoGenerateColumns="False" AlternationCount="2" AutomationProperties.Name="Recent MCP activity">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="145"/>
              <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="55"/>
              <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="125"/>
              <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="*"/>
              <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="90"/>
              <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100"/>
              <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="145"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>

        <!-- MAINTENANCE -->
        <ScrollViewer x:Name="MaintenancePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
              <StackPanel>
                <TextBlock x:Name="GlobalWarningText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12"/>
                <TextBlock x:Name="MaintenanceAvailabilityText" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock x:Name="CurrentOperationLabel" Text="Current operation" FontWeight="SemiBold"/>
                <TextBlock x:Name="OperationText" TextWrapping="Wrap" Margin="0,8,0,12"/>
                <WrapPanel>
                  <Button x:Name="MaintenanceApplyButton" Content="Refresh managed Source" Click="Apply_Click" IsEnabled="False"/>
                  <Button x:Name="VerifyButton" Content="Deep verify" Click="Verify_Click" IsEnabled="False" Margin="8,4,0,4"/>
                  <Button x:Name="RepairButton" Content="Recover safely" Click="Repair_Click" IsEnabled="False" Margin="8,4,0,4"/>
                  <Button x:Name="UpdateButton" Content="Update Worker" Click="Update_Click" IsEnabled="False" Margin="8,4,0,4"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock x:Name="SourceUpdateTitleLabel" Text="Incoming Source update" FontWeight="SemiBold"/>
                <TextBlock x:Name="SourceUpdateStatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,12"/>
                <TextBlock x:Name="SourceUpdateSelectLabel" Text="Artifact" FontWeight="SemiBold"/>
                <ComboBox x:Name="SourceArtifactCombo" SelectionChanged="SourceArtifact_SelectionChanged" Margin="0,7,0,10" MinWidth="420" AutomationProperties.Name="Source update artifact">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="SyncExtensionButton" Style="{StaticResource PrimaryButton}" Content="Update selected extension" Click="SyncExtension_Click" IsEnabled="False" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True"/>
                <TextBlock x:Name="SyncExtensionHelpText" TextWrapping="Wrap" Margin="0,7,0,10" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="SourceSyncResultText" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Expander x:Name="SourceAdvancedExpander" Foreground="{DynamicResource TextBrush}">
                <Expander.Header><TextBlock x:Name="SourceAdvancedLabel" Text="Advanced: manual Incoming update" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/></Expander.Header>
                <WrapPanel>
                  <Button x:Name="PrepareSourceUpdateButton" Content="Prepare update folder" Click="PrepareSourceUpdate_Click" IsEnabled="False"/>
                  <Button x:Name="OpenIncomingButton" Content="Open prepared folder" Click="OpenIncoming_Click" IsEnabled="False" Margin="8,4,0,4"/>
                  <Button x:Name="AcceptSourceUpdateButton" Content="Accept update" Click="AcceptSourceUpdate_Click" IsEnabled="False" Margin="8,4,0,4"/>
                  <Button x:Name="CancelSourceUpdateButton" Content="Cancel update" Click="CancelSourceUpdate_Click" IsEnabled="False" Margin="8,4,0,4"/>
                </WrapPanel>
                </Expander>
              </StackPanel>
            </Border>
            <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" Margin="0,14,0,0">
              <StackPanel><TextBlock x:Name="DiagnosticsLabel" Text="Diagnostics" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticsText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/></StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- SETTINGS -->
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed" MaxWidth="620" HorizontalAlignment="Left">
          <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="1" x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem x:Name="LanguageSystemItem" Tag="system" Content="System"/><ComboBoxItem x:Name="LanguageRuItem" Tag="ru" Content="Русский"/><ComboBoxItem x:Name="LanguageEnItem" Tag="en" Content="English"/>
              </ComboBox>
              <TextBlock Grid.Row="1" x:Name="ThemeLabel" Text="Theme" VerticalAlignment="Center" Margin="0,12,0,0"/>
              <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged" Margin="0,12,0,0">
                <ComboBoxItem x:Name="ThemeSystemItem" Tag="system" Content="System"/><ComboBoxItem x:Name="ThemeLightItem" Tag="light" Content="Light"/><ComboBoxItem x:Name="ThemeDarkItem" Tag="dark" Content="Dark"/>
              </ComboBox>
              <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="StartupCheckBox" Content="Start Control Center with Windows (operator choice)" Margin="0,18,0,0" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ADVANCED -->
        <ScrollViewer x:Name="AdvancedPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Button x:Name="HomeOpenSourceButton" Content="Open Source folder" Click="OpenSource_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <TextBlock x:Name="AdvancedTitleLabel" Text="Technical identities and receipts" FontSize="16" FontWeight="SemiBold"/>
            <TextBox x:Name="AdvancedText" Margin="0,12,0,0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="480" AutomationProperties.Name="Technical identities and receipts"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
