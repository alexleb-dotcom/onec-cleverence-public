<Window x:Class="OneCArchitecture.ControlCenter.ProjectWizardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Add project" Width="680" Height="620" MinWidth="620" MinHeight="540"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
 <ScrollViewer Background="{DynamicResource WindowBrush}" VerticalScrollBarVisibility="Auto">
  <Grid Margin="24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <TextBlock Grid.ColumnSpan="3" x:Name="WizardTitleLabel" Text="New 1C project" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
   <TextBlock Grid.Row="1" x:Name="WizardProjectLabel" Text="Project name" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ProjectNameBox"/>
   <TextBlock Grid.Row="2" x:Name="WizardSystemLabel" Text="System / base" VerticalAlignment="Center" Margin="0,10,0,0"/><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SystemNameBox" Margin="0,10,0,0"/>
   <TextBlock Grid.Row="3" x:Name="WizardRoleLabel" Text="Role / purpose" VerticalAlignment="Center" Margin="0,10,0,0"/><TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RoleBox" Margin="0,10,0,0"/>
   <TextBlock Grid.Row="4" x:Name="WizardMainLabel" Text="Main XML folder" VerticalAlignment="Center" Margin="0,10,0,0"/>
   <TextBox Grid.Row="4" Grid.Column="1" x:Name="MainPathBox" Margin="0,10,8,0"/>
   <Button Grid.Row="4" Grid.Column="2" x:Name="BrowseMainButton" Content="Browse…" Click="BrowseMain_Click" Margin="0,10,0,0"/>
   <Separator Grid.Row="5" Grid.ColumnSpan="3" Margin="0,20,0,14"/>
   <CheckBox Grid.Row="6" Grid.ColumnSpan="3" x:Name="ExtensionCheck" Content="Add one extension now" Checked="ExtensionCheck_Changed" Unchecked="ExtensionCheck_Changed"/>
   <TextBlock Grid.Row="7" x:Name="WizardExtensionLabel" Text="Extension name" VerticalAlignment="Center" Margin="0,10,0,0"/>
   <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ExtensionNameBox" IsEnabled="False" Margin="0,10,0,0"/>
   <TextBlock Grid.Row="8" x:Name="WizardExtensionFolderLabel" Text="Extension XML folder" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,10,12,0"/>
   <TextBox Grid.Row="8" Grid.Column="1" x:Name="ExtensionPathBox" IsEnabled="False" Margin="0,10,8,0"/>
   <Button Grid.Row="8" Grid.Column="2" x:Name="BrowseExtensionButton" Content="Browse…" IsEnabled="False" Click="BrowseExtension_Click" Margin="0,10,0,0"/>
   <StackPanel Grid.Row="9" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
    <Button x:Name="CreateButton" Content="Create and refresh Source" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="170" Click="Create_Click"/>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</Window>
