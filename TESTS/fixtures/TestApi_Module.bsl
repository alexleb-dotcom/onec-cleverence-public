// Складывает два обязательных параметра.
// Возвращает результат сложения.
Функция Foo(ПервыйПараметр, ВторойПараметр) Экспорт
	Возврат ПервыйПараметр + ВторойПараметр;
КонецФункции

// Выполняет тестовое действие.
Процедура Bar(ПервыйПараметр, ВторойПараметр = Неопределено) Экспорт
КонецПроцедуры

Функция Hidden()
	// Слово Экспорт внутри тела не делает функцию публичной.
	Возврат "Экспорт";
КонецФункции
