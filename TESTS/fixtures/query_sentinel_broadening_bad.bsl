Функция ПолучитьСтрокиДокумента(Документ)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	| Строки.Ссылка
	|ИЗ
	| Документ.ЗаказКлиента.Товары КАК Строки
	|ГДЕ
	| Строки.Ссылка = &Документ
	| ИЛИ &Документ = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Документ", Документ);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
