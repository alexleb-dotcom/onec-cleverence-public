	Граница = СтрНайти(ВРег(Материал), "ПОМЕСТИТЬ");
	Хвост = Сред(Материал, Граница);
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка ПОМЕСТИТЬ ВТОснова ИЗ Справочник.Номенклатура";
	Запрос.Выполнить();
