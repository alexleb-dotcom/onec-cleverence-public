      "category": "MODULE_SOURCE",
      "logical_target": "DOCUMENT.Test.ObjectModule",
      "required_for_claim": "fixture:source-logic",
      "minimum_fidelity": "FULL"
    },
    {
      "id": "scheduled-jobs-runtime",
