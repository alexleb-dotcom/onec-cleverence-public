// baseline candidate marker for DIFF_ATTRIBUTION activation fixture.
&НаСервере
&После("ПередЗаписью")
Процедура ТестАктивацииПрофилей(Источник, Отказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 1";
	ДинамическийСписок = Источник.ДинамическийСписок;
	НачатьТранзакцию();
	Попытка
		Структура = Новый Структура("Номенклатура,Характеристика,Упаковка", Источник.Номенклатура, Источник.Характеристика, Источник.Упаковка);
		Если ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.Тест") И Источник.Процент <= 0 Тогда
			Представление = Строка(Источник.Ссылка);
		КонецЕсли;
		Для Каждого Элемент Из Источник.Коллекция Цикл
			Источник.Индекс.Вставить(Элемент.Ключ, Элемент);
		КонецЦикла;
		УстановитьПривилегированныйРежим(Истина);
		ТестApi.Метод(Источник);
		НормализоватьДанные(Источник);
	Исключение
		Отказ = Истина;
	КонецПопытки;
КонецПроцедуры
