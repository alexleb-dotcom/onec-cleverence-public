Функция ПолучитьСтрокиДокумента(Документ)
	Запрос = Новый Запрос;
	Если Документ = Документы.ЗаказКлиента.ПустаяСсылка() Тогда
		Запрос.Текст = "ВЫБРАТЬ
		| Строки.Ссылка
		|ИЗ
		| Документ.ЗаказКлиента.Товары КАК Строки";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		| Строки.Ссылка
		|ИЗ
		| Документ.ЗаказКлиента.Товары КАК Строки
		|ГДЕ
		| Строки.Ссылка = &Документ";
		Запрос.УстановитьПараметр("Документ", Документ);
	КонецЕсли;
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
