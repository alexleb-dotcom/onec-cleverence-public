Процедура ПолучитьОдноЗначениеИзВладельца() Экспорт
	ТекстВладельца = ВладелецДанных.ПолучитьСлужебныйТекстЗапроса();
	Позиция = СтрНайти(ВРег(ТекстВладельца), "ПОМЕСТИТЬ");
	Хвост = Сред(ТекстВладельца, Позиция);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Ссылка ПОМЕСТИТЬ ВТОснова ИЗ Справочник.Номенклатура;
	|ВЫБРАТЬ Ссылка ПОМЕСТИТЬ ВТРезультат ИЗ ВТОснова";
	Запрос.Выполнить();
	ВладелецДанных.ЗаполнитьВТСлужебно();
КонецПроцедуры
